<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="coopcinelles_partner_list.PartnerLineOverride"
        t-inherit="point_of_sale.PartnerLine"
        t-inherit-mode="extension"
    >
        <!-- 1. MOBILE MODE : Hide the address and contact block with d-none class -->
        <xpath expr="//div[hasclass('partner-line-adress')]" position="attributes">
            <attribute name="class">partner-line-adress p-1 d-none</attribute>
        </xpath>
        <xpath expr="//div[hasclass('partner-line-email')]" position="attributes">
            <attribute name="class">partner-line-email p-1 d-none</attribute>
        </xpath>
        <xpath expr="//div[hasclass('partner-line-email')]" position="after">
            <t t-set="membershipBadge" t-value="getMembershipBadge(props.partner)" />
            <div class="partner-line-membership p-1" t-if="membershipBadge">
                <span
                    t-attf-class="badge rounded-pill {{ membershipBadge.badgeClass }}"
                    t-esc="membershipBadge.label"
                />
            </div>
        </xpath>

        <!-- 2. DESKTOP MODE : Hide the address cell -->
        <xpath
            expr="//tr[hasclass('partner-info')]//td[./div[hasclass('partner-line-adress')]]"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>

        <!-- 3. DESKTOP MODE : Hide the contact cell (Phone / Email) -->
        <xpath expr="//td[hasclass('partner-line-email')]" position="attributes">
            <attribute name="class">partner-line-email d-none</attribute>
        </xpath>

        <!-- 4. DESKTOP MODE : Display membership badge aligned with header -->
        <xpath expr="//td[hasclass('partner-line-email')]" position="after">
            <td class="partner-line-membership py-2 align-middle">
                <t t-set="membershipBadge" t-value="getMembershipBadge(props.partner)" />
                <span
                    t-if="membershipBadge"
                    t-attf-class="badge rounded-pill {{ membershipBadge.badgeClass }}"
                    t-esc="membershipBadge.label"
                />
            </td>
        </xpath>
    </t>
</templates>
