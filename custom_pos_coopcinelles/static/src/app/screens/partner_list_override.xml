<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- 
    Original template path: 
        * addons/point_of_sale/static/src/app/screens/partner_list/partner_line/partner_line.xml
    Override PartnerList template to hide address and contact columns 
    -->
    <t t-name="mon_module_pos_client.PartnerLineOverride" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension">
        <!-- Example : target a specific item  by classto hide it -->
        <xpath expr="//th[normalize-space(text())='Address']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//th[hasclass('partner-line-email')]" position="attributes">
            <attribute name="class">partner-line-email d-none</attribute>
        </xpath>
    </t>
</templates>