<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- 
    Original template path: 
        * addons/point_of_sale/static/src/app/screens/partner_list/partner_line/partner_line.xml
    Extend PartnerLine template to hide a column 
    -->
    <t t-name="mon_module_pos_client.PartnerLineOverride" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <!-- Example : target a specific item by classto hide it -->
        <!-- Small UI -->
        <xpath expr="//div[hasclass('partner-info')]//div[hasclass('partner-line-adress')]" position="attributes">
            <attribute name="class">partner-line-adress d-none</attribute>
        </xpath>
        <xpath expr="//div[hasclass('partner-info')]//div[hasclass('partner-line-email')]" position="attributes">
            <attribute name="class">partner-line-email d-none</attribute>
        </xpath>
        <!-- Large UI -->
        <xpath expr="//td[div[hasclass('partner-line-adress')]]" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//td[hasclass('partner-line-email')]" position="attributes">
            <attribute name="class">partner-line-email d-none</attribute>
        </xpath>
    </t>
</templates>