# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# https://editorconfig.org

root = true

# Global settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Specific rules for Python files
[*.py]
indent_size = 4

# Specific rules for XML / Odoo views
[*.{xml,html}]
indent_size = 4

# Specific rules for configuration files (JSON, YAML) often using 2 spaces
[*.{json,yml,yaml}]
indent_size = 2

# Specific rules for Markdown files (often 2 or 4 spaces, keeping 4 by default or 2)
[*.md]
trim_trailing_whitespace = false
